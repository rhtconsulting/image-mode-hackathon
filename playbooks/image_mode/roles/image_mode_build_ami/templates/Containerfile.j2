###############################################################################
# Image Mode bootc container
###############################################################################

ARG IMAGE_MODE_BASE_IMAGE

FROM ${IMAGE_MODE_BASE_IMAGE}

###############################################################################
# Build-stage arguments
###############################################################################

ARG IMAGE_MODE_BASE_IMAGE
ARG IMAGE_MODE_RHEL_RELEASE

###############################################################################
# Validate required build arguments
###############################################################################

RUN set -eux; \
    test -n "${IMAGE_MODE_BASE_IMAGE}"; \
    test -n "${IMAGE_MODE_RHEL_RELEASE}"; \
    printf 'Selected base image: %s\n' "${IMAGE_MODE_BASE_IMAGE}"; \
    printf 'Selected RHEL release: %s\n' "${IMAGE_MODE_RHEL_RELEASE}"

###############################################################################
# Validate the selected RHEL bootc base image
###############################################################################

RUN set -eux; \
    test -r /etc/os-release; \
    . /etc/os-release; \
    test "${ID}" = "rhel"; \
    base_major="${VERSION_ID%%.*}"; \
    selected_major="${IMAGE_MODE_RHEL_RELEASE%%.*}"; \
    test "${base_major}" = "${selected_major}"; \
    printf 'Building from %s %s\n' "${NAME}" "${VERSION_ID}"; \
    printf 'Satellite release: %s\n' "${IMAGE_MODE_RHEL_RELEASE}"

###############################################################################
# Configure DNF for the Satellite-managed release
###############################################################################

RUN set -eux; \
    mkdir -p /etc/dnf/vars; \
    printf '%s\n' "${IMAGE_MODE_RHEL_RELEASE}" \
        > /etc/dnf/vars/releasever

###############################################################################
# Install application and EC2 prerequisites
###############################################################################

RUN set -eux; \
    dnf -y clean all; \
    rm -rf /var/cache/dnf; \
    dnf \
        --releasever="${IMAGE_MODE_RHEL_RELEASE}" \
        -y install \
        nginx \
        cloud-init \
        openssh-server \
        chrony \
        sudo \
        curl; \
    dnf -y clean all; \
    rm -rf /var/cache/dnf

###############################################################################
# Add application content
###############################################################################

COPY files/index.html /usr/share/nginx/html/index.html

###############################################################################
# Configure EC2 cloud-init
###############################################################################

RUN set -eux; \
    mkdir -p /etc/cloud/cloud.cfg.d; \
    printf '%s\n' \
        'datasource_list: [ Ec2, None ]' \
        > /etc/cloud/cloud.cfg.d/99-ec2-datasource.cfg

###############################################################################
# Enable deployed services
###############################################################################

RUN set -eux; \
    systemctl enable nginx.service; \
    systemctl enable sshd.service; \
    systemctl enable chronyd.service; \
    systemctl enable cloud-init-local.service; \
    systemctl enable cloud-init.service; \
    systemctl enable cloud-config.service; \
    systemctl enable cloud-final.service

###############################################################################
# Record image metadata
###############################################################################

RUN set -eux; \
    printf '%s\n' \
        'IMAGE_NAME={{ image_mode_image_name }}' \
        'IMAGE_VERSION={{ image_mode_image_tag }}' \
        "RHEL_VERSION=${IMAGE_MODE_RHEL_RELEASE}" \
        'APPLICATION={{ image_mode_application_name }}' \
        'CONTAINER_IMAGE={{ image_mode_image_reference }}' \
        "BASE_IMAGE=${IMAGE_MODE_BASE_IMAGE}" \
        > /etc/image-mode-release

###############################################################################
# Expose metadata as OCI/container labels
#
# These labels allow Ansible to validate the image without executing it.
###############################################################################

LABEL containers.bootc="1" \
      org.opencontainers.image.title="{{ image_mode_image_name }}" \
      org.opencontainers.image.version="{{ image_mode_image_tag }}" \
      com.redhat.image-mode.rhel-release="${IMAGE_MODE_RHEL_RELEASE}" \
      com.redhat.image-mode.base-image="${IMAGE_MODE_BASE_IMAGE}" \
      com.redhat.image-mode.application="{{ image_mode_application_name }}"

###############################################################################
# Validate bootc support
###############################################################################

RUN test -x /usr/bin/bootc \
    || test -x /usr/libexec/bootc

EXPOSE 22
EXPOSE 80

CMD ["/sbin/init"]