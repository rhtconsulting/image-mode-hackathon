###############################################################################
# Image Mode Bootc Container
###############################################################################

ARG IMAGE_MODE_BASE_IMAGE
ARG IMAGE_MODE_RHEL_RELEASE

FROM ${IMAGE_MODE_BASE_IMAGE}

###############################################################################
# Validate the selected bootc base image
###############################################################################

RUN set -eux; \
    test -r /etc/os-release; \
    . /etc/os-release; \
    test "${ID}" = "rhel"; \
    printf 'Building from %s %s\n' "${NAME}" "${VERSION_ID}"

###############################################################################
# Configure DNF to use the Satellite release lock
###############################################################################

RUN mkdir -p /etc/dnf/vars \
    && printf '%s\n' "${IMAGE_MODE_RHEL_RELEASE}" \
       > /etc/dnf/vars/releasever

###############################################################################
# Validate release consistency
###############################################################################

RUN set -eux; \
    . /etc/os-release; \
    base_major="${VERSION_ID%%.*}"; \
    selected_major="${IMAGE_MODE_RHEL_RELEASE%%.*}"; \
    test "${base_major}" = "${selected_major}"; \
    printf 'Base Image Version      : %s\n' "${VERSION_ID}"; \
    printf 'Satellite Release       : %s\n' "${IMAGE_MODE_RHEL_RELEASE}"

###############################################################################
# Install application and EC2 prerequisites
###############################################################################

RUN dnf -y clean all \
    && rm -rf /var/cache/dnf \
    && dnf \
        --releasever="${IMAGE_MODE_RHEL_RELEASE}" \
        -y install \
            nginx \
            cloud-init \
            openssh-server \
            chrony \
            sudo \
            curl \
    && dnf -y clean all \
    && rm -rf /var/cache/dnf

###############################################################################
# Add application content
###############################################################################

COPY files/index.html \
     /usr/share/nginx/html/index.html

###############################################################################
# Configure EC2 cloud-init
###############################################################################

RUN mkdir -p /etc/cloud/cloud.cfg.d \
    && printf '%s\n' \
        'datasource_list: [ Ec2, None ]' \
        > /etc/cloud/cloud.cfg.d/99-ec2-datasource.cfg

###############################################################################
# Enable required services
###############################################################################

RUN systemctl enable nginx.service \
    && systemctl enable sshd.service \
    && systemctl enable chronyd.service \
    && systemctl enable cloud-init-local.service \
    && systemctl enable cloud-init.service \
    && systemctl enable cloud-config.service \
    && systemctl enable cloud-final.service

###############################################################################
# Record image metadata
###############################################################################

RUN printf '%s\n' \
        'IMAGE_NAME={{ image_mode_image_name }}' \
        'IMAGE_VERSION={{ image_mode_image_tag }}' \
        "RHEL_VERSION=${IMAGE_MODE_RHEL_RELEASE}" \
        'APPLICATION={{ image_mode_application_name }}' \
        'CONTAINER_IMAGE={{ image_mode_image_reference }}' \
        "BASE_IMAGE=${IMAGE_MODE_BASE_IMAGE}" \
        > /etc/image-mode-release

###############################################################################
# Validate bootc support
###############################################################################

RUN test -x /usr/bin/bootc \
    || test -x /usr/libexec/bootc

LABEL containers.bootc="1"

###############################################################################
# Network
###############################################################################

EXPOSE 22
EXPOSE 80

###############################################################################
# Default init process
###############################################################################

CMD ["/sbin/init"]